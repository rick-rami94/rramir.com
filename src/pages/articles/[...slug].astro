---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { readingTime } from '../../lib/reading.js';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((a) => ({ params: { slug: a.slug }, props: { article: a } }));
}

const { article } = Astro.props;
const { Content } = await article.render();
const dateStr = article.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const mins = readingTime(article.body);
const canonical = new URL(`/articles/${article.slug}/`, Astro.site);
const publishedIso = article.data.date.toISOString();
const ogImageUrl = new URL('/og.png', Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.data.title,
  description: article.data.description,
  datePublished: publishedIso.slice(0, 10),
  dateModified: publishedIso.slice(0, 10),
  inLanguage: 'en-US',
  image: ogImageUrl,
  author: { '@type': 'Person', name: 'Rick Ramirez', url: 'https://rramir.com' },
  publisher: {
    '@type': 'Person',
    name: 'Rick Ramirez',
    url: 'https://rramir.com',
    logo: { '@type': 'ImageObject', url: ogImageUrl },
  },
  url: canonical.href,
  mainEntityOfPage: canonical.href,
  keywords: article.data.tags.join(', '),
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://rramir.com/' },
    { '@type': 'ListItem', position: 2, name: 'Writing', item: 'https://rramir.com/articles/' },
    { '@type': 'ListItem', position: 3, name: article.data.title, item: canonical.href },
  ],
};
---

<Base
  title={`${article.data.title} — Rick Ramirez`}
  description={article.data.description}
  ogType="article"
  publishedTime={publishedIso}
  tags={article.data.tags}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

  <header class="nav">
    <div class="container nav-inner">
      <a class="nav-logo" href="/">rramir<span class="dot">.</span>com</a>
      <nav>
        <ul class="nav-links">
          <li><a href="/#writing">Writing</a></li>
          <li><a href="/#projects">Projects</a></li>
          <li><a href="/#contact">Contact</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <article class="article">
    <div class="container container-narrow">
      <a class="article-back" href="/#writing">← Writing</a>
      <p class="article-date">{dateStr} · {mins} min read</p>
      <h1 class="article-title">{article.data.title}</h1>
      <p class="article-desc">{article.data.description}</p>

      {
        article.data.tags.length > 0 && (
          <div class="article-tags">
            {article.data.tags.map((t) => (
              <span class="tag">{t}</span>
            ))}
          </div>
        )
      }

      {
        article.data.linkedinUrl && (
          <a
            class="article-linkedin"
            href={article.data.linkedinUrl}
            target="_blank"
            rel="noopener"
          >
            Originally published on LinkedIn ↗
          </a>
        )
      }

      <div class="article-body">
        <Content />
      </div>

      <div class="article-foot">
        <a class="btn btn-ghost" href="/#writing">← Back to all writing</a>
        {
          article.data.linkedinUrl && (
            <a
              class="btn btn-primary"
              href={article.data.linkedinUrl}
              target="_blank"
              rel="noopener"
            >
              Discuss on LinkedIn ↗
            </a>
          )
        }
      </div>
    </div>
  </article>
</Base>
