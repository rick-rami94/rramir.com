---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { readingTime } from '../lib/reading.js';
import {
  profile,
  credentials,
  languages,
  focusAreas,
  experience,
  standards,
  expertise,
  faqs,
  certifications,
  education,
  projects,
  speaking,
  services,
} from '../data/site.js';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmtDate = (d) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });

const personJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://rramir.com/#website',
      url: 'https://rramir.com/',
      name: 'Rick Ramirez',
      description:
        'Cyber-physical and AI security — securing surgical robotics, OT/ICS, and RF systems, and the AI being built into them.',
      inLanguage: 'en-US',
      publisher: { '@id': 'https://rramir.com/#person' },
    },
    {
      '@type': 'Person',
      '@id': 'https://rramir.com/#person',
      name: profile.name,
      url: 'https://rramir.com',
      image: 'https://rramir.com/portrait.jpeg',
      jobTitle: 'Cyber-Physical & AI Security Engineer',
      description:
        'Cyber-physical and AI security professional based in the New York City metropolitan area — securing surgical robotics, OT/ICS, and RF systems, and the AI being built into them.',
      email: `mailto:${profile.email}`,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'New York City',
        addressRegion: 'NY',
        addressCountry: 'US',
      },
      areaServed: { '@type': 'Place', name: 'New York City metropolitan area' },
      hasOccupation: {
        '@type': 'Occupation',
        name: 'Cyber-Physical & AI Security Engineer',
        occupationLocation: { '@type': 'City', name: 'New York City' },
      },
      worksFor: { '@type': 'Organization', name: 'Johnson & Johnson' },
      alumniOf: education.map((e) => ({ '@type': 'EducationalOrganization', name: e.school })),
      sameAs: [profile.linkedin, profile.github],
      knowsAbout: [...expertise, ...standards],
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://rramir.com/#faq',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<Base>
  <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

  <!-- Nav -->
  <header class="nav">
    <div class="container nav-inner">
      <a class="nav-logo" href="#top">rramir<span class="dot">.</span>com</a>
      <nav>
        <ul class="nav-links">
          <li><a href="#about">About</a></li>
          <li><a href="/securing-ai">Securing AI</a></li>
          <li><a href="#experience">Experience</a></li>
          <li><a href="#projects">Projects</a></li>
          {articles.length > 0 && <li><a href="#writing">Writing</a></li>}
          <li><a href="#services">Advisory</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <!-- Hero -->
  <section class="hero" id="top">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="hero-eyebrow"><span class="pulse"></span> {profile.role}</span>
        <h1>
          {profile.name}<span class="accent">.</span>
        </h1>
        <p class="hero-tagline">{profile.tagline}</p>
        <p class="hero-location">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          Cyber-physical &amp; AI security · New York City metropolitan area
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#contact">Get in touch</a>
          <a class="btn btn-ghost" href="/securing-ai">Securing AI ↗</a>
          <a class="btn btn-ghost" href={profile.linkedin} target="_blank" rel="noopener">
            LinkedIn ↗
          </a>
          <a class="btn btn-ghost" href={profile.github} target="_blank" rel="noopener">
            GitHub ↗
          </a>
        </div>
        <div class="hero-creds">
          {
            credentials.map((c) => {
              const Tag = c.link ? 'a' : 'span';
              const linkProps = c.link
                ? { href: c.link, target: '_blank', rel: 'noopener' }
                : {};
              return (
                <Tag class="cred" {...linkProps}>
                  {c.icon === 'mic' && (
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z" />
                      <path d="M19 10v2a7 7 0 0 1-14 0v-2" />
                      <line x1="12" y1="19" x2="12" y2="23" />
                    </svg>
                  )}
                  {c.icon === 'award' && (
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="8" r="6" />
                      <path d="M15.5 13.5 17 22l-5-3-5 3 1.5-8.5" />
                    </svg>
                  )}
                  <strong>{c.label}</strong>
                  <em>{c.sub}</em>
                </Tag>
              );
            })
          }
        </div>
      </div>
      <div class="hero-portrait">
        <img
          src="/portrait.jpeg"
          width="400"
          height="400"
          alt={`Portrait of ${profile.name}, cyber-physical and AI security engineer`}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about">
    <div class="container">
      <p class="section-label reveal">// about</p>
      <h2 class="section-title reveal">From risk methodology to working systems</h2>
      <p class="section-lead reveal">{profile.intro}</p>

      <div class="grid grid-3">
        {
          focusAreas.map((f) => (
            <div class="card focus-card reveal">
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </div>
          ))
        }
      </div>

      <div class="tag-list reveal">
        {standards.map((s) => <span class="tag">{s}</span>)}
      </div>

      <div class="languages reveal">
        <span class="lang-label">Languages</span>
        <span class="lang-list">{languages.join(' · ')}</span>
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section id="experience">
    <div class="container">
      <p class="section-label reveal">// experience</p>
      <h2 class="section-title reveal">Where I've worked</h2>
      {
        experience.map((co) => (
          <div class="exp-co reveal">
            <div class="exp-co-head">
              <h3 class="exp-co-name">{co.org}</h3>
              {co.meta && <span class="exp-co-meta">{co.meta}</span>}
            </div>
            <div class="exp-roles">
              {co.roles.map((r) => (
                <div class="exp-item">
                  <div class="exp-head">
                    <span class="exp-role">{r.role}</span>
                    <span class="exp-period">{r.period}</span>
                  </div>
                  {r.points.length > 0 && (
                    <ul class="exp-points">
                      {r.points.map((p) => (
                        <li>{p}</li>
                      ))}
                    </ul>
                  )}
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Certifications -->
  <section id="certifications">
    <div class="container">
      <p class="section-label reveal">// certifications</p>
      <h2 class="section-title reveal">Certifications</h2>
      <div class="cert-groups">
        {
          certifications.map((g) => (
            <div class="cert-group reveal">
              <h3 class="cert-group-title">{g.group}</h3>
              <div class="cert-list">
                {g.items.map((c) => (
                  <div class="cert-card">
                    <div class="cert-top">
                      <span class="cert-name">{c.name}</span>
                      {c.note && (
                        <span class={`cert-note${c.note === 'In progress' ? ' is-progress' : ''}`}>
                          {c.note}
                        </span>
                      )}
                    </div>
                    <span class="cert-issuer">{c.issuer}</span>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Education -->
  <section id="education">
    <div class="container">
      <p class="section-label reveal">// education</p>
      <h2 class="section-title reveal">Education</h2>
      <div class="edu-list reveal">
        {
          education.map((e) => (
            <div class="edu-item">
              <div class="edu-main">
                <span class="edu-school">{e.school}</span>
                <span class="edu-detail">{e.detail}</span>
              </div>
              <span class="edu-period">{e.period}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section id="projects">
    <div class="container">
      <p class="section-label reveal">// projects</p>
      <h2 class="section-title reveal">Things I've built</h2>
      <p class="section-lead reveal">
        Security-first tools across OT/ICS risk assessment and AI agent systems —
        built to be auditable, governed, and honest about their limits.
      </p>

      <div class="grid grid-2">
        {
          projects.map((p) => (
            <div class="card proj-card reveal">
              <span class="proj-tag">{p.tag}</span>
              <h3>{p.name}</h3>
              <p>{p.blurb}</p>
              <div class="proj-stack">
                {p.stack.map((s) => (
                  <span>{s}</span>
                ))}
              </div>
              {p.link ? (
                <a class="proj-link" href={p.link} target="_blank" rel="noopener">
                  {p.linkLabel} ↗
                </a>
              ) : (
                <span class="proj-link disabled">{p.linkLabel}</span>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Speaking -->
  <section id="speaking">
    <div class="container">
      <p class="section-label reveal">// speaking</p>
      <h2 class="section-title reveal">Speaking &amp; research</h2>
      {
        speaking.map((t) => (
          <article class="talk reveal">
            <div class="talk-head">
              <span class="proj-tag">Featured Talk</span>
              <span class="talk-venue">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z" />
                  <path d="M19 10v2a7 7 0 0 1-14 0v-2" />
                  <line x1="12" y1="19" x2="12" y2="23" />
                </svg>
                {t.venue}
              </span>
            </div>
            <h3 class="talk-title">{t.title}</h3>
            <p class="talk-sub">{t.subtitle}</p>
            <p class="talk-blurb">{t.blurb}</p>
            <div class="proj-stack talk-tags">
              {t.tags.map((x) => (
                <span>{x}</span>
              ))}
            </div>
            <div class="talk-actions">
              {t.slides && (
                <a class="btn btn-primary" href={t.slides} download>
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                    <polyline points="7 10 12 15 17 10" />
                    <line x1="12" y1="15" x2="12" y2="3" />
                  </svg>
                  Download slides (PDF)
                </a>
              )}
              {t.whitepaper && (
                <a class="btn btn-ghost" href={t.whitepaper} download>
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                    <line x1="16" y1="13" x2="8" y2="13" />
                    <line x1="16" y1="17" x2="8" y2="17" />
                    <line x1="10" y1="9" x2="8" y2="9" />
                  </svg>
                  Download white paper (PDF)
                </a>
              )}
              {t.link && (
                <a class="btn btn-ghost" href={t.link} target="_blank" rel="noopener">
                  {t.linkLabel} ↗
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Writing -->
  {
    articles.length > 0 && (
      <section id="writing">
        <div class="container">
          <p class="section-label reveal">// writing</p>
          <h2 class="section-title reveal">Writing</h2>
          <p class="section-lead reveal">
            Notes on OT/ICS security, RF and cyber-physical systems, risk
            methodology, and security-first AI.
          </p>
          <div class="article-list reveal">
            {articles.slice(0, 4).map((a) => (
              <a class="article-row" href={`/articles/${a.slug}`}>
                <span class="article-row-date">
                  {fmtDate(a.data.date)}
                  <span class="article-row-mins">{readingTime(a.body)} min read</span>
                </span>
                <span class="article-row-main">
                  <span class="article-row-title">{a.data.title}</span>
                  <span class="article-row-desc">{a.data.description}</span>
                </span>
                <span class="article-row-arrow">→</span>
              </a>
            ))}
          </div>
          {articles.length > 4 && (
            <div class="services-cta reveal">
              <a class="btn btn-ghost" href="/articles">All writing →</a>
            </div>
          )}
        </div>
      </section>
    )
  }

  <!-- Advisory -->
  <section id="services">
    <div class="container">
      <p class="section-label reveal">// advisory</p>
      <h2 class="section-title reveal">Advisory &amp; consulting</h2>
      <p class="section-lead reveal">
        Standards-aligned assessment that turns a sprawling environment into a clear,
        prioritized view of cyber risk — and a plan to reduce it. Available for select
        advisory engagements alongside my full-time work.
      </p>

      <div class="grid grid-3">
        {
          services.map((s) => (
            <div class="card reveal">
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          ))
        }
      </div>

      <div class="services-cta reveal">
        <a class="btn btn-primary" href="#contact">Start a conversation →</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq">
    <div class="container container-narrow">
      <p class="section-label reveal">// faq</p>
      <h2 class="section-title reveal">Frequently asked</h2>
      <dl class="faq-list reveal">
        {
          faqs.map((f) => (
            <div class="faq-item">
              <dt class="faq-q">{f.q}</dt>
              <dd class="faq-a">{f.a}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="contact">
    <div class="container">
      <div class="card reveal">
        <h2>Let's talk</h2>
        <p>
          Open to advisory conversations about cyber-physical risk, product security,
          and securing AI systems. The fastest way to reach me is email.
        </p>
        <div class="contact-actions">
          <a class="btn btn-primary" href={`mailto:${profile.email}`}>{profile.email}</a>
          <a class="btn btn-ghost" href={profile.linkedin} target="_blank" rel="noopener">
            LinkedIn ↗
          </a>
          <a class="btn btn-ghost" href={profile.github} target="_blank" rel="noopener">
            GitHub ↗
          </a>
        </div>
        <p class="contact-note">
          Looking for my résumé? Email me and I’ll send it over.
        </p>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="container footer-inner">
      <span>© {new Date().getFullYear()} {profile.name}</span>
      <div class="footer-links">
        <a href={profile.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a href={profile.github} target="_blank" rel="noopener">GitHub</a>
        <a href={`mailto:${profile.email}`}>Email</a>
      </div>
      <span class="mono">rramir.com</span>
    </div>
  </footer>
</Base>
